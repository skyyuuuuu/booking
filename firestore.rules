rules_version = '2';

// ============================================================
// 常態班級劃位系統 Firestore 安全規則
// 部署方式：Firebase Console → Firestore Database → 規則 → 整份貼上 → 發布
// ⚠️ 請把下面 isAdmin() 裡的 email 改成你的管理員 Gmail（可放多個）
// ============================================================
//
// 學生代碼（key）= 家長手機 + "_" + 學生姓名，例如 0912345678_王小明
// 家長輸入姓名＋手機，系統組出 key 去比對名單；知道 key 才能劃位、換位、取消。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // 用 get() 讀取，匿名使用者沒有 email 欄位時才不會出錯
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in [
          'YOUR_ADMIN_EMAIL@gmail.com'
        ];
    }

    // ---------- 教室座位範本：只有管理員能看、能改 ----------
    match /rooms/{rid} {
      allow read, write: if isAdmin();
    }

    // ---------- 學生索引：這個學生上哪些班 ----------
    // 只能用完整的 key 讀單筆（等於要知道姓名＋手機），不能列出全部
    match /students/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ---------- 班級 ----------
    match /classes/{cid} {
      allow read: if true;
      allow write: if isAdmin();

      function cls() {
        return get(/databases/$(database)/documents/classes/$(cid)).data;
      }
      function sub(name, id) {
        return /databases/$(database)/documents/classes/$(cid)/$(name)/$(id);
      }
      function canEdit() {
        return signedIn() && cls().open == true;
      }

      // 學生名單：只有管理員看得到
      match /roster/{key} {
        allow read, write: if isAdmin();
      }

      // 座位（公開）：文件存在 = 已被劃走，只存一個無意義的劃位編號，不含個資
      match /seats/{seatId} {
        allow read: if true;

        allow create: if isAdmin() || (canEdit()
          && seatId in cls().seats
          && request.resource.data.keys().hasOnly(['bid', 'bookedAt'])
          && request.resource.data.bookedAt == request.time
          && getAfter(sub('bookings', request.resource.data.bid)).data.seatId == seatId);

        allow delete: if isAdmin() || (canEdit()
          && !existsAfter(sub('bookings', resource.data.bid)));

        allow update: if false;
      }

      // 劃位紀錄（含姓名、手機）：只有管理員讀得到
      match /bookings/{bid} {
        allow read: if isAdmin();

        allow create: if isAdmin() || (canEdit()
          && request.resource.data.keys().hasOnly(['key', 'seatId', 'name', 'phone', 'bookedAt'])
          && request.resource.data.keys().hasAll(['key', 'seatId', 'name', 'phone', 'bookedAt'])
          && request.resource.data.key == request.resource.data.phone + '_' + request.resource.data.name
          // 必須在這個班的名單裡
          && exists(sub('roster', request.resource.data.key))
          && request.resource.data.bookedAt == request.time
          && getAfter(sub('seats', request.resource.data.seatId)).data.bid == bid
          && getAfter(sub('holders', request.resource.data.key)).data.bid == bid);

        allow delete: if isAdmin() || (canEdit()
          && !existsAfter(sub('seats', resource.data.seatId))
          && (!existsAfter(sub('holders', resource.data.key))
              || getAfter(sub('holders', resource.data.key)).data.bid != bid));

        allow update: if false;
      }

      // 座位持有：每個學生每班只有一份，記錄他目前坐哪裡
      // 文件 ID = 學生 key，所以同一個學生不可能同時佔兩個位子
      match /holders/{key} {
        allow get: if true;
        allow list: if isAdmin();

        // 第一次劃位
        allow create: if isAdmin() || (canEdit()
          && request.resource.data.keys().hasOnly(['bid', 'seatId'])
          && getAfter(sub('bookings', request.resource.data.bid)).data.key == key
          && getAfter(sub('bookings', request.resource.data.bid)).data.seatId == request.resource.data.seatId);

        // 換位：舊的劃位紀錄必須在同一次操作中刪掉
        allow update: if isAdmin() || (canEdit()
          && request.resource.data.keys().hasOnly(['bid', 'seatId'])
          && getAfter(sub('bookings', request.resource.data.bid)).data.key == key
          && getAfter(sub('bookings', request.resource.data.bid)).data.seatId == request.resource.data.seatId
          && !existsAfter(sub('bookings', resource.data.bid)));

        // 取消
        allow delete: if isAdmin() || (canEdit()
          && !existsAfter(sub('bookings', resource.data.bid)));
      }
    }
  }
}
